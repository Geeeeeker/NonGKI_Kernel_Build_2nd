name: 红米1Build Xiaomi Redmi K20 Pro (AOSP Based A17) (Soviet-Star-OSS)

on:
  workflow_call:
  workflow_dispatch:

env:
  # Device env
  DEVICE_NAME : "redmi_k20_pro"
  DEVICE_CODENAME : "raphael"

  CUSTOM_CMDS : "CLANG_TRIPLE=aarch64-linux-gnu-"
  EXTRA_CMDS : "LLVM=1 LLVM_IAS=1"

  #KERNEL_SOURCE : "https://github.com/Geeeeeker/kernel_xiaomi_raphael-pixel.git"
  #KERNEL_BRANCH : "16.0"

  KERNEL_SOURCE : "https://github.com/Geeeeeker/android_kernel_xiaomi_sm8150-5.4.git"
  KERNEL_BRANCH : "MI_RAPHAEL_5.4"

  CLANG_SOURCE : "https://raw.githubusercontent.com/Neutron-Toolchains/antman/main/antman"
  CLANG_BRANCH : ""

  GCC_GNU : false
  GCC_64_SOURCE : ""
  GCC_64_BRANCH : ""
  GCC_32_SOURCE : ""
  GCC_32_BRANCH : ""

  DEFCONFIG_SOURCE: ""
  DEFCONFIG_NAME : "raphael_defconfig"
  DEFCONFIG_ORIGIN_IMAGE: ""
  DEFCONFIG_FROM_BOOT: false

  KERNELSU_SOURCE : ""
  KERNELSU_BRANCH : ""

  KERNELSU_AUTO_GET : "true"
  KERNELSU_AUTO_FORK : "bakasu" # xxksu, rsuntk , next, bakasu and sukisu

  SUSFS_ENABLE : true
  SUSFS_FIXED : true

  AK3_SOURCE : "https://github.com/erg-raphael-5-4/AnyKernel3.git"
  AK3_BRANCH : "main"

  # 打包 boot.img 用的源镜像
  #BOOT_SOURCE : "https://github.com/Geeeeeker/KernelSU_Kernel_Raphael/raw/refs/heads/a17-5.4-resukisu/boot/boot-lineage-raphael.img"
  BOOT_SOURCE : "https://github.com/Geeeeeker/boot/releases/download/lineage-24-raphael-20261029-134503/boot.img"
  NEED_DTBO : false
  NEED_SAFE_DTBO : false

  ROM_TEXT : "aosp_a15"

  # Other env
  PYTHON_VERSION: "3" # Only 2(Ubuntu 22.04 and Ubuntu 20.04) or 3(Any OS Versions).

  PACK_METHOD: "AnyKernel3" # AnyKernel3 need SOURCE and BRANCH, MKBOOTIMG needn't it.
  PACK_KMODULES: "false" # if u want pack kernel modules (.ko) into AnyKernel3.

  KERNELSU_METHOD: "shell" # shell, manual and only.

  PATCHES_SOURCE: "JackA1ltman/NonGKI_Kernel_Patches" # [your_name]/[your_patch] -> gooder123/NonGKI_Patcher
  PATCHES_BRANCH: "mi_kernel" # [your_branch] -> main

  SUSFS_FOLDER_FIXED: "k20p_aosp_sovietstar_a15" # Fill in your patch prefix directory here. Leave it blank if there isn't one. -> your_folder
  SUSFS_PATCH_FIXED: "susfs_fixed" # Fill in your patches here. If there are multiple patches, please separate them with a comma. Leave it blank if there isn't one. -> patch1,patch2

  REKERNEL_ENABLE: "false" # if u need Re:Kernel.
  DROIDSPACES_ENABLE: "false" # if u need Droidspaces or LXC/Docker.
  NOMOUNT_ENABLE: "false" # if u need NoMount.

  HOOK_METHOD: "syscall" # Manual hook method ->  syscall.

  KPM_ENABLE: "false" # Anyone devices.
  KPM_INLINE: "false" # Only use it for SukiSU-Ultra.
  KPM_KPATCH_NEXT: "false" # If u want hook KPatch-Next in build step.
  KPM_PATCH_SOURCE: "https://raw.githubusercontent.com/SukiSU-Ultra/SukiSU_patch/refs/heads/main/kpm/patch_linux" # If u want to use KPM Inline,so you need set patch exec file source -> raw.githubusercontent.com/Test/Test/patch .

  BASEBAND_GUARD_ENABLE: "false" #if u want prevent unauthorized writes to critical partitions/device nodes.
  BASEBAND_GUARD_BOOT: "false" #if u want to protect boot partition.

  GENERATE_DTB: "false" # if u kernel need DTB , but cannot auto generate it. (Only AnyKernel3).
  GENERATE_CHIP: "qcom" # only supported for qcom and mediatek.

  BUILD_DEBUGGER: "false" # Output build errors.
  SKIP_PATCH: "false" # Ignore errors found in Patch Debugger.

  BUILD_OTHER_CONFIG: "false" # Merge config files.
  MERGE_CONFIG_FILES: "vendor/debugfs.config,vendor/lahaina_QGKI.config"

  FREE_MORE_SPACE: "false" # if u want get more space, enabled it.

jobs:
  build-kernel:
    name: Xiaomi Redmi K20 Pro (AOSP Based A17) (kernel 5.4)
    runs-on: ubuntu-24.04 # u can changed to ubuntu 22.04, and need container set ubuntu-24.04
    # container: archlinux/archlinux:latest # if u need use arch linux -> archlinux/archlinux:latest or ubuntu 20.04 -> ubuntu:focal
    env:
      CCACHE_COMPILERCHECK: "%compiler% -dumpmachine; %compiler% -dumpversion"
      CCACHE_NOHASHDIR: "true"
      CCACHE_HARDLINK: "true"

    steps:
      - name: ⏰ Checkout repository
        uses: actions/checkout@v6

      - name: ⌛️ Compilation environment preparation
        uses: ./.github/workflows/build-env

      - name: ⚙️ Get necessary tools
        uses: ./.github/workflows/build-ready

      - name: 🪝 Patch Kernel of SUSFS
        uses: ./.github/workflows/patch-susfs

      - name: 🔗 Patch for no-kprobe
        uses: ./.github/workflows/patch-no-kprobe

      - name: 🪛 Extra Kernel Options
        run: |
          # Only ${{ env.DEVICE_NAME }} use it.
          cd $GITHUB_WORKSPACE/device_kernel
          # Nothing

      - name: 🧰 Patch Kernel of Re:Kernel
        uses: ./.github/workflows/patch-rekernel

      - name: 💿 Patch Kernel of Droidspaces
        uses: ./.github/workflows/patch-droidspaces

      - name: 🔒 Patch Kernel of Baseband Guard
        uses: ./.github/workflows/patch-baseband-guard

      - name: 🛡️ Patch Kernel of NoMount
        uses: ./.github/workflows/patch-nomount

      - name: 🧩 Apply user kernel modifications
        run: |
          set -euo pipefail
          cd "$GITHUB_WORKSPACE/device_kernel"

          # 添加 rtl8188eus WiFi 驱动（原样）
          git clone --depth=1 --branch master https://github.com/Geeeeeker/android_kernel_xiaomi_sdm845.git rtl8188eus-repo
          if [ -d "rtl8188eus-repo/drivers/rtl8188eus" ]; then
            cp -r rtl8188eus-repo/drivers/rtl8188eus drivers/
            echo 'obj-$(CONFIG_RTL8188EU) += rtl8188eus/' >> drivers/Makefile
            echo 'source "drivers/rtl8188eus/Kconfig"' >> drivers/Kconfig
          else
            grep -n 'ksu_handle_stat' fs/stat.c
            echo "Error: rtl8188eus directory not found"
            exit 1
          fi
          rm -rf rtl8188eus-repo

          # 4. 修复 rtl8188eus 在 clang -Werror 下触发的 -Wparentheses-equality
          #    原因：usb_halinit.c 里 if ((IS_FULL_SPEED_USB(Adapter)) ... 多包了一层括号，
          #    该驱动是第三方老代码，直接对其目录关闭该警告最安全。
          if [ -f drivers/rtl8188eus/Makefile ]; then
            if ! grep -q 'Wno-parentheses-equality' drivers/rtl8188eus/Makefile; then
              cat >> drivers/rtl8188eus/Makefile <<'EOF'

          # Third-party rtl8188eus driver: silence clang's -Werror=parentheses-equality
          subdir-ccflags-y += -Wno-parentheses-equality
          subdir-ccflags-y += -Wno-error=parentheses-equality
          EOF
              echo "rtl8188eus: appended -Wno-parentheses-equality to Makefile"
            else
              echo "rtl8188eus: -Wno-parentheses-equality already present"
            fi
          else
            echo "rtl8188eus: Makefile not found, skip warning suppression"
          fi
        env:
          KERNEL_DIR: ${{ github.workspace }}/device_kernel
          ARCH: arm64

      - name: 🚀 Build Process
        uses: ./.github/workflows/build-process

      - name: 🔌 Build USB/IP modules and userspace tools
        run: |
          set -euo pipefail

          KERNEL_DIR=${KERNEL_DIR:?KERNEL_DIR must be set}
          ROOT=${GITHUB_WORKSPACE:-$(cd "${KERNEL_DIR}/.." && pwd)}
          ARCH=${ARCH:-arm64}

          # ========== 设置 QEMU 用户态支持 (用于 arm64 容器) ==========
          sudo apt-get update
          sudo apt-get install -y qemu-user-static binfmt-support
          docker run --rm --privileged multiarch/qemu-user-static --reset -p yes

          # ========== 编译 USB/IP 内核模块（可选） ==========
          cd "$KERNEL_DIR"
          export SHELL=/bin/bash
          export PATH="${CLANG_PATH:-}:${PATH}"
          make -j"$(nproc)" \
            SHELL=/bin/bash \
            ARCH=arm64 \
            LLVM=1 \
            LLVM_IAS=1 \
            O=out \
            CROSS_COMPILE=aarch64-linux-gnu- \
            LD=ld.lld \
            M=drivers/usb/usbip \
            modules || echo "Warning: USB/IP modules build skipped or failed."

          mkdir -p "$ROOT/usbip-out/modules"
          if ls out/drivers/usb/usbip/*.ko 1> /dev/null 2>&1; then
              cp out/drivers/usb/usbip/*.ko "$ROOT/usbip-out/modules/"
          else
              echo "No USB/IP kernel modules generated (probably built-in)."
          fi

          # ========== 编译 USB/IP 用户态工具 (Docker arm64 容器) ==========
          mkdir -p "$ROOT/usbip-out/bin" "$ROOT/usbip-out/libs"
          kernel_rel="${KERNEL_DIR#"$ROOT"/}"
          [ "$kernel_rel" = "$KERNEL_DIR" ] && kernel_rel="$(basename "$KERNEL_DIR")"

          docker run --rm --platform linux/arm64 \
            --memory=3g \
            -v "$ROOT:/workspace" \
            -v "$ROOT/usbip-out:/output" \
            -w "/workspace/$kernel_rel" \
            arm64v8/ubuntu:22.04 \
            bash -c "
              set -e
              export DEBIAN_FRONTEND=noninteractive
              ulimit -s unlimited
              apt update
              apt install -y \
                build-essential \
                autoconf \
                libtool \
                pkg-config \
                libudev-dev \
                libssl-dev \
                flex \
                bison \
                file \
                patchelf
              cd tools/usb/usbip
              ./autogen.sh
              ./configure CFLAGS=\"-Wno-error -Wno-error=stringop-truncation\" --with-tcp-wrappers=no
              make -j1
              cp src/.libs/usbip /output/bin/
              cp src/.libs/usbipd /output/bin/
              cp libsrc/.libs/libusbip.so.0* /output/libs/
              cd /output
              BINARIES=\"bin/usbip bin/usbipd libs/libusbip.so.0*\"
              DEPS=\"\"
              for file in \$BINARIES; do
                if [ -f \"\$file\" ]; then
                  needed=\$(readelf -d \"\$file\" | grep NEEDED | awk '{print \$5}' | tr -d '[]' || true)
                  for lib in \$needed; do
                    if [[ \"\$DEPS\" != *\"\$lib\"* ]]; then
                      DEPS=\"\$DEPS \$lib\"
                    fi
                  done
                fi
              done
              for lib in \$(echo \$DEPS | tr ' ' '\\n' | sort -u); do
                libpath=\$(ldconfig -p | grep \"\$lib (\" | head -1 | awk '{print \$NF}' || true)
                if [ -z \"\$libpath\" ]; then
                  libpath=\$(find /lib /usr/lib -name \"\$lib\" -type f 2>/dev/null | head -1 || true)
                fi
                if [ -n \"\$libpath\" ]; then
                  cp -P \"\$libpath\" libs/ 2>/dev/null || cp \"\$libpath\" libs/
                  for reallib in \$(find \"\$(dirname \"\$libpath\")\" -name \"\${lib%.so*}*\" -type f 2>/dev/null); do
                    cp -n \"\$reallib\" libs/ 2>/dev/null || true
                  done
                fi
              done
              ld_linux=\"/lib/ld-linux-aarch64.so.1\"
              if [ -f \"\$ld_linux\" ]; then
                cp -P \"\$ld_linux\" libs/
              fi
            "

          # ========== 打包 USB/IP 产物 ==========
          cd "$ROOT/usbip-out"
          tar czf "$ROOT/usbip-arm64-bundle.tar.gz" .
        env:
          KERNEL_DIR: ${{ github.workspace }}/device_kernel
          ARCH: arm64

      - name: 🔩 Pack Process
        uses: ./.github/workflows/pack-process

      - name: ✏️ Upload Artifacts
        uses: ./.github/workflows/upload-files

      - name: 📦 Make boot.img
        if: env.BOOT_SOURCE != ''
        shell: bash
        run: |
          set -euo pipefail
          WORKSPACE="$GITHUB_WORKSPACE"
          TOOLS="$WORKSPACE/mkboottools"
          IMAGE_DIR="$WORKSPACE/device_kernel/out/arch/${ARCH}/boot"

          # 1) 确保 mkbootimg 工具存在（build-ready 已准备则复用）
          if [ ! -f "$TOOLS/unpack_bootimg.py" ] || [ ! -f "$TOOLS/mkbootimg.py" ]; then
            echo "[*] cloning mkbootimg tools"
            rm -rf "$TOOLS"
            git clone -q --depth=1 -b main-kernel \
              https://android.googlesource.com/platform/system/tools/mkbootimg "$TOOLS"
          fi

          # 2) 下载源 boot.img
          echo "[*] downloading source boot.img"
          curl -fL --retry 3 --retry-delay 2 \
            -o "$WORKSPACE/boot_source.img" "${{ env.BOOT_SOURCE }}"

          # 3) 选内核镜像（优先用 KERNEL_IMAGE_NAME，否则按 AK3 顺序探测）
          KIMAGE=""
          for cand in "${KERNEL_IMAGE_NAME:-}" Image.gz-dtb Image-dtb Image.gz Image; do
            [ -n "$cand" ] || continue
            if [ -f "$IMAGE_DIR/$cand" ]; then KIMAGE="$cand"; break; fi
          done
          [ -n "$KIMAGE" ] || { echo "[x] no kernel image found under $IMAGE_DIR"; ls "$IMAGE_DIR"; exit 1; }
          echo "[+] using kernel image: $KIMAGE"

          # 4) 解包源 boot，取得 mkbootimg 参数
          cd "$WORKSPACE"
          FORMAT=$(python3 "$TOOLS/unpack_bootimg.py" \
                     --boot_img "$WORKSPACE/boot_source.img" --format mkbootimg)
          echo "[*] source boot args: $FORMAT"
          python3 "$TOOLS/unpack_bootimg.py" --boot_img "$WORKSPACE/boot_source.img" >/dev/null

          # 5) 替换 kernel 并重打包为 $WORKSPACE/boot.img
          mkdir -p "$WORKSPACE/out"
          cp -fp "$IMAGE_DIR/$KIMAGE" "$WORKSPACE/out/kernel"
          eval "python3 \"$TOOLS/mkbootimg.py\" $FORMAT -o \"$WORKSPACE/boot.img\""
          [ -s "$WORKSPACE/boot.img" ] || { echo "[x] boot.img not produced"; exit 1; }
          echo "[+] boot.img built ($(du -h "$WORKSPACE/boot.img" | cut -f1))"

          rm -f "$WORKSPACE/boot_source.img"
        env:
          ARCH: arm64

      - name: Upload boot image
        if: hashFiles('boot.img') != ''
        uses: actions/upload-artifact@v4
        with:
          name: boot${{ env.LOCALVERSION }}${{ env.UPLOADNAME }}-${{ env.DEVICE }}-${{ env.BUILD_TIME }}
          path: ${{ github.workspace }}/boot.img
          if-no-files-found: error

      - name: Upload kernel image
        if: env.UPLOAD_KERNEL_IMAGE == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: ${{ env.KERNEL_IMAGE_NAME }}${{ env.LOCALVERSION }}${{ env.UPLOADNAME }}-${{ env.DEVICE }}-${{ env.BUILD_TIME }}
          path: ${{ github.workspace }}/device_kernel/out/arch/${{ env.ARCH }}/boot/${{ env.KERNEL_IMAGE_NAME }}
          if-no-files-found: error

      - name: Upload real kernel config
        if: env.ENABLE_STOCKCONFIG == 'true' && hashFiles('device_kernel/out/.config') != ''
        uses: actions/upload-artifact@v4
        with:
          name: config${{ env.LOCALVERSION }}${{ env.UPLOADNAME }}-${{ env.DEVICE }}-${{ env.BUILD_TIME }}
          path: ${{ github.workspace }}/device_kernel/out/.config
          include-hidden-files: true

      - name: Upload USB/IP bundle
        uses: actions/upload-artifact@v4
        with:
          name: usbip-arm64-bundle
          path: ${{ github.workspace }}/usbip-arm64-bundle.tar.gz
          if-no-files-found: error
